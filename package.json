{
  "name": "pingme",
  "displayName": "PingMe",
  "description": "User reminders for VS Code",
  "version": "0.0.1",
  "publisher": "Nithin_m_m",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pingMe.open",
        "title": "PingMe: Open Reminders"
      },
      {
        "command": "pingMe.addReminder",
        "title": "PingMe: Add Reminder",
        "icon": "$(add)"
      },
      {
        "command": "pingMe.activateReminder",
        "title": "PingMe: Activate Reminder",
        "icon": "$(bell)"
      },
      {
        "command": "pingMe.deactivateReminder",
        "title": "PingMe: Deactivate Reminder",
        "icon": "$(bell-slash)"
      },
      {
        "command": "pingMe.deleteReminder",
        "title": "PingMe: Delete Reminder",
        "icon": "$(trash)"
      },
      {
        "command": "pingMe.customizeReminder",
        "title": "PingMe: Customize Reminder",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pingMe.addScreenTimeReminder",
        "title": "PingMe: Add Screen Time Interval",
        "icon": "$(watch)"
      },
      {
        "command": "pingMe.activateScreenTimeReminder",
        "title": "PingMe: Resume Screen Time Interval",
        "icon": "$(play)"
      },
      {
        "command": "pingMe.deactivateScreenTimeReminder",
        "title": "PingMe: Pause Screen Time Interval",
        "icon": "$(debug-pause)"
      },
      {
        "command": "pingMe.deleteScreenTimeReminder",
        "title": "PingMe: Delete Screen Time Interval",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pingMeBar",
          "title": "PingMe",
          "icon": "media/pingme.svg"
        }
      ]
    },
    "views": {
      "pingMeBar": [
        {
          "type": "tree",
          "id": "pingMe.reminders",
          "name": "Reminders",
          "icon": "media/pingme.svg"
        },
        {
          "type": "tree",
          "id": "pingMe.screenTime",
          "name": "Screen Time",
          "icon": "$(watch)"
        },
        {
          "type": "webview",
          "id": "pingMe.todos",
          "name": "To-dos",
          "icon": "$(checklist)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pingMe.addReminder",
          "when": "view == pingMe.reminders",
          "group": "navigation"
        },
        {
          "command": "pingMe.addScreenTimeReminder",
          "when": "view == pingMe.screenTime",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pingMe.deactivateReminder",
          "when": "view == pingMe.reminders && viewItem == reminder-active",
          "group": "inline"
        },
        {
          "command": "pingMe.activateReminder",
          "when": "view == pingMe.reminders && viewItem == reminder-inactive",
          "group": "inline"
        },
        {
          "command": "pingMe.deleteReminder",
          "when": "view == pingMe.reminders",
          "group": "inline"
        },
        {
          "command": "pingMe.customizeReminder",
          "when": "view == pingMe.reminders",
          "group": "2_configure"
        },
        {
          "command": "pingMe.deactivateScreenTimeReminder",
          "when": "view == pingMe.screenTime && viewItem == screen-time-active",
          "group": "inline"
        },
        {
          "command": "pingMe.activateScreenTimeReminder",
          "when": "view == pingMe.screenTime && viewItem == screen-time-inactive",
          "group": "inline"
        },
        {
          "command": "pingMe.deleteScreenTimeReminder",
          "when": "view == pingMe.screenTime",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pingMe.reminders",
        "contents": "No reminders yet. [Add a reminder](command:pingMe.addReminder)"
      },
      {
        "view": "pingMe.screenTime",
        "contents": "No screen-time intervals yet. [Add an interval](command:pingMe.addScreenTimeReminder)"
      },
      {
        "view": "pingMe.todos",
        "contents": "No to-dos yet. Select **Add to-do** to create one."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/copy-animations.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}